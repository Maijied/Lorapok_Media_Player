<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Album Art / App Icon -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/ic_launcher_round"
        android:scaleType="centerCrop"
        android:contentDescription="Album Art"
        android:layout_marginEnd="12dp" />

    <!-- Title + Controls Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lorapok Player"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to play"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Transport Controls Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:textColor="#00F3FF"
                android:text="⏮"
                android:textSize="16sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#1A00F3FF"
                android:textColor="#00F3FF"
                android:text="▶"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:textColor="#00F3FF"
                android:text="⏭"
                android:textSize="16sp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
